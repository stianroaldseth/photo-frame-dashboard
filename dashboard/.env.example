# Copy to .env for local use (`cp .env.example .env`). On Railway, set these as service variables.

# Required in production. The tablet opens https://<host>/?token=<this>.
# Generate with: openssl rand -hex 24
DASHBOARD_TOKEN=

# Kids' names (kept out of the public repo).
KID1_NAME=
KID2_NAME=

# Secret iCal address(es) of the shared Google Calendar(s), comma-separated.
# Optional person prefix: family=https://calendar.google.com/calendar/ical/…/basic.ics,stian=https://…
# Without it the calendar widgets show a sample calendar.
CALENDAR_URLS=

# Length of the cheapest EV charging window in hours (default 3).
# CHARGE_HOURS=3

# 1 = mock data for every widget (offline development).
# MOCK=1

# Optional. Railway sets this automatically.
# PORT=3000
